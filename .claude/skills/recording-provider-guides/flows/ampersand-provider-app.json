{
  "name": "ampersand-provider-app",
  "description": "Add a provider's OAuth app credentials to an Ampersand project.",
  "viewport": {
    "width": 1024,
    "height": 768
  },
  "start": "https://dashboard.withampersand.com/projects/{{projectId}}",
  "steps": [
    {
      "number": 3,
      "caption": "Select **Provider apps**.",
      "target": "a[href$='/provider-apps']",
      "action": "click",
      "expect": "xpath=//button[normalize-space()='+ New App']"
    },
    {
      "number": 4,
      "caption": "Click **+ New App**.",
      "target": "xpath=//button[normalize-space()='+ New App']",
      "action": "click",
      "expect": "label[for='form-provider']"
    },
    {
      "number": 5,
      "caption": "Select **{{providerName}}** from the **Provider** list.",
      "target": "label[for='form-provider'] [class*='-control']",
      "action": "select",
      "value": "{{providerName}}",
      "expect": "#form-clientId"
    },
    {
      "number": 6,
      "caption": "Enter the **Client ID** obtained from your {{providerName}} app.",
      "target": "#form-clientId",
      "action": "fill",
      "value": "your-client-id"
    },
    {
      "number": 6,
      "caption": "Enter the **Client Secret** obtained from your {{providerName}} app.",
      "target": "#form-clientSecret",
      "action": "fill",
      "value": "your-client-secret"
    },
    {
      "number": 7,
      "caption": "Click **Save changes**.",
      "target": "form input[type='submit']",
      "action": "none"
    }
  ]
}
