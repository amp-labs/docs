{
  "viewport": {
    "width": 1024,
    "height": 768
  },
  "start": "https://marketplace.zoom.us/user/build",
  "mask": [
    "[aria-label^='Current User']"
  ],
  "steps": [
    {
      "caption": "Click **+** next to **Developer** and select **Build app**.",
      "target": "button[aria-label='Add']",
      "action": "click",
      "expect": "xpath=//*[normalize-space()='Build app']"
    },
    {
      "caption": "Click **+** next to **Developer** and select **Build app**.",
      "target": "xpath=(//*[normalize-space()='Build app'])[last()]",
      "action": "click",
      "expect": "xpath=//label[.//*[normalize-space()='General app']]"
    },
    {
      "caption": "Select **General app**, then click **Create**.",
      "target": "xpath=//label[.//*[normalize-space()='General app']]",
      "action": "click",
      "expect": "xpath=//button[normalize-space()='Create' and not(@disabled)]"
    },
    {
      "caption": "Select **General app**, then click **Create**.",
      "target": "xpath=//button[normalize-space()='Create']",
      "action": "none"
    }
  ]
}
