{
  "viewport": {
    "width": 1024,
    "height": 768
  },
  "start": "https://marketplace.zoom.us/develop/applications/{{appId}}/information",
  "mask": [
    "[aria-label^='Current User']",
    "input[name=clientId]",
    "input[name=clientSecret]",
    "xpath=//*[normalize-space(text())='App credentials']/../.."
  ],
  "steps": [
    {
      "number": 4,
      "caption": "In the **OAuth information** section, set the redirect URL to `https://api.withampersand.com/callbacks/v1/oauth`.",
      "target": "input[name=redirectUri]",
      "action": "none"
    },
    {
      "number": 5,
      "caption": "Go to **Scopes**.",
      "target": "xpath=(//button[@aria-label='Back']/../..//button)[2]",
      "action": "click",
      "expect": "xpath=//a[normalize-space()='Scopes']"
    },
    {
      "number": 5,
      "caption": "Go to **Scopes**.",
      "target": "xpath=//a[normalize-space()='Scopes']",
      "action": "click",
      "expect": "button[aria-label='close']"
    },
    {
      "number": 5,
      "caption": "Go to **Scopes**.",
      "target": "button[aria-label='close']",
      "action": "click",
      "expect": "xpath=//button[normalize-space()='Add scopes']"
    },
    {
      "number": 6,
      "caption": "Click **Add scopes** and select the scopes your app uses.",
      "target": "xpath=//button[normalize-space()='Add scopes']",
      "action": "click",
      "expect": "input[placeholder='Search scope']"
    },
    {
      "number": 6,
      "caption": "Click **Add scopes** and select the scopes your app uses.",
      "target": "input[placeholder='Search scope']",
      "action": "fill",
      "value": "meeting:read:list_meetings",
      "expect": "xpath=//li[.//span[normalize-space()='meeting:read:list_meetings']]"
    },
    {
      "number": 6,
      "caption": "Click **Add scopes** and select the scopes your app uses.",
      "target": "xpath=//li[.//span[normalize-space()='meeting:read:list_meetings']]",
      "action": "none"
    }
  ],
  "secrets": [
    "input[name=clientId]"
  ]
}
